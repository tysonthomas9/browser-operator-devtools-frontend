# Langfuse Integration Configuration Template
# Copy this file to .env and fill in your actual values

# Enable/disable Langfuse integration
LANGFUSE_ENABLE=true

# Langfuse server configuration
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_HOST=http://localhost:3000  # For self-hosted Langfuse

# Langfuse API credentials 
# Get these from your Langfuse project settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# Optional: Langfuse project and environment tags
# LANGFUSE_PROJECT=browser-operator
# LANGFUSE_ENV=development

# Optional: Eval Server Configuration overrides
# BO_EVAL_SERVER_HOST=127.0.0.1
# BO_EVAL_SERVER_PORT=8080
# BO_EVAL_SERVER_LOG_LEVEL=INFO

# Optional: Browsecomp-specific settings
# BROWSECOMP_DATASET_PATH=/path/to/custom/dataset
# BROWSECOMP_DEFAULT_TIMEOUT=3600