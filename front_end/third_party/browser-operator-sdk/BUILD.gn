import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_pre_built.gni")
import("../visibility.gni")

devtools_pre_built("browser-operator-sdk") {
  sources_are_release = false

  sources = [
    # TypeScript configuration
    "browser-operator-sdk-tsconfig.json",

    # Main SDK exports
    "index.d.ts",
    "index.d.cts",
    "index.js",

    # Shared type chunks (generated by tsup)
    "OpenAIProvider-iNYdLE4U.d.ts",
    "OpenAIProvider-Cu-1Cnad.d.cts",
    "createTool-DopF4riH.d.ts",
    "createTool-D1YWm90c.d.cts",
    "types-SSahUagS.d.ts",
    "types-SSahUagS.d.cts",
    "utils-CPLTWdHl.d.ts",
    "utils-CPLTWdHl.d.cts",

    # Agent module
    "agent/index.d.ts",
    "agent/index.d.cts",
    "agent/index.js",

    # Tools module
    "tools/index.d.ts",
    "tools/index.d.cts",
    "tools/index.js",

    # Workflows module
    "workflows/index.d.ts",
    "workflows/index.d.cts",
    "workflows/index.js",

    # State module
    "state/index.d.ts",
    "state/index.d.cts",
    "state/index.js",

    # Hooks module
    "hooks/index.d.ts",
    "hooks/index.d.cts",
    "hooks/index.js",

    # Events module
    "events/index.d.ts",
    "events/index.d.cts",
    "events/index.js",

    # Types module
    "types/index.d.ts",
    "types/index.d.cts",
    "types/index.js",

    # LLM module
    "llm/index.d.ts",
    "llm/index.d.cts",
    "llm/index.js",

    # Memory module
    "memory/index.d.ts",
    "memory/index.d.cts",
    "memory/index.js",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "browser-operator-sdk.ts"

  deps = [
    ":browser-operator-sdk",
    # Zod dependency (already available from mcp-sdk)
    "../mcp-sdk:mcp-sdk",
  ]

  visibility = [
    "../../panels/ai_chat/*",
  ]

  visibility += devtools_third_party_visibility
}
